# ============================================================
# CityTrace — environment configuration
# ============================================================
#
# Copy to .env.local and fill in the values:
#
#   cp .env.example .env.local
#
# Two groups, and the distinction matters:
#
#   NEXT_PUBLIC_*   inlined into the browser bundle. Public.
#   everything else read only in server code. Never sent to a client.
#
# Never add a service-role key here. Nothing in this app uses one, and
# a NEXT_PUBLIC_ service-role key would hand every visitor full
# database access.
# ============================================================


# ------------------------------------------------------------
# Supabase (required)
# ------------------------------------------------------------
#
# From Project Settings -> API. Both are NEXT_PUBLIC_* and therefore
# exposed to the browser. That is intentional: all access control is
# enforced by Postgres row-level security, not by hiding the key. The
# consequence is that the RLS policies ARE the security boundary — see
# docs/IMPLEMENTATION_AUDIT.md.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key — safe to expose, RLS-gated.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------
# AI complaint triage (optional — server only)
# ------------------------------------------------------------
#
# Read by src/lib/ai/ollama.ts, which runs only inside
# POST /api/ai/analyze. None of these are NEXT_PUBLIC_, and none of
# them may become NEXT_PUBLIC_: the model endpoint and the triage
# prompt are not the browser's business, and classification is an
# authority decision made server-side after authenticating the caller.
#
# Leave OLLAMA_BASE_URL empty and the pipeline still works. Every
# complaint is classified by the deterministic keyword engine in
# src/lib/ai/deterministic.ts instead, and complaints.ai_model records
# "citytrace-rules-v2" so nobody later mistakes a keyword match for a
# model judgement. Nothing is stubbed and nothing is fabricated — the
# fallback exists because a complaint that is not classified is a
# complaint that is not routed and has no SLA deadline.
#
# Local models only. There is no hosted-AI dependency, no vendor SDK
# and no API key, so citizen-reported complaint text never leaves the
# infrastructure Ollama runs on.

# Base URL of an Ollama server, e.g. http://127.0.0.1:11434
# Empty or unset => no model provider; deterministic classification.
OLLAMA_BASE_URL=

# Model tag to use. Must already be pulled on that server
# (`ollama pull llama3.2`). Defaults to llama3.2.
# A missing model is recorded as ai_error_message and falls back.
OLLAMA_MODEL=llama3.2

# How long to wait for a classification before falling back, in ms.
# Defaults to 20000. Past roughly this point the citizen is watching a
# spinner for something the rule engine produces instantly.
AI_REQUEST_TIMEOUT_MS=20000

# Sampling temperature. Defaults to 0, and 0 is the right answer:
# two officers looking at the same complaint should not see two
# different priorities.
AI_TEMPERATURE=0

# Minimum confidence to accept a model's classification, 0-1.
# Defaults to 0.35. Below it the model has said it does not know, and
# its answer is discarded in favour of the rule engine rather than
# stored as though it were a judgement. Tune per model.
AI_MIN_CONFIDENCE=0.35
