# ============================================================
# CityTrace — environment configuration
# ============================================================
#
# Copy to .env.local and fill in the values from your Supabase
# project (Project Settings -> API):
#
#   cp .env.example .env.local
#
# These are the ONLY two variables the codebase reads. Verified by:
#   grep -rhoE "process\.env\.[A-Z_]+" src/ proxy.ts | sort -u
#
# Both are NEXT_PUBLIC_* and therefore exposed to the browser. That is
# intentional: all access control is enforced by Postgres row-level
# security, not by hiding the key. The consequence is that the RLS
# policies ARE the security boundary — see docs/IMPLEMENTATION_AUDIT.md.
#
# Never add a service-role key here. Nothing in this app uses one, and
# a NEXT_PUBLIC_ service-role key would hand every visitor full
# database access.
# ============================================================

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key — safe to expose, RLS-gated.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
